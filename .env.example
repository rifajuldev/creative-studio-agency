# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID="a48vt0i7"
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2026-05-15"

# Public site URL (canonical URLs, sitemap, Open Graph, JSON-LD)
NEXT_PUBLIC_SITE_URL="https://www.nextcreavo.com"

# Agency backend API (briefs + bookings). Local default: http://localhost:5000/api/v1
NEXT_PUBLIC_API_URL="http://localhost:5000/api/v1"

# Google Analytics 4 — Google tag (gtag.js). One tag per site; do not also load GTM unless you remove this.
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-SY8XHE63J2"

# Optional: Google Tag Manager (leave empty if using gtag above — do not use both)
# NEXT_PUBLIC_GTM_ID="GTM-WZ6GJF2C"

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
